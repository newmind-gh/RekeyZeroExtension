{
  "name": "@rekeyzero/extension",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite build --mode personal --watch",
    "build": "node scripts/build.mjs",
    "build:personal": "npm run build",
    "check": "node scripts/build.mjs --pretty false",
    "check:personal": "npm run check",
    "test": "vitest run --mode personal",
    "test:e2e": "npm run build && playwright test tests/personal-orchestration.e2e.ts tests/control-adapters.e2e.ts tests/source-prepare.e2e.ts",
    "test:e2e:personal": "npm run test:e2e",
    "release": "node scripts/release.mjs",
    "release:personal": "npm run release"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.82",
    "@ossredact/core": "0.2.1",
    "docling.rs-wasm": "1.93.5",
    "lucide-react": "^0.540.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "^10.2.2",
    "@types/chrome": "^0.1.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.5",
    "fflate": "0.8.3",
    "secretlint": "^10.2.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
